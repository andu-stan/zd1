# Our changes on top of busybox's `make defconfig` (nix/module/busybox.nix applies them, the applets of os.toml
# [busybox] on and every other applet off, then `make oldconfig`). Both builds, the system's and the rescue's.
CONFIG_STATIC=y
CONFIG_CROSS_COMPILER_PREFIX="arm-linux-musleabi-"
CONFIG_EXTRA_CFLAGS="-march=armv5te -mtune=arm926ej-s"
# x86-only
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set
# Every applet goes into /bin and /sbin (no /usr/bin links)
CONFIG_INSTALL_NO_USR=y
# ntpd sets the clock once (S46time); it serves no one
# CONFIG_FEATURE_NTPD_SERVER is not set
